<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Pixelscreens theme: Linear-style dark chrome (flat panels, hairline borders,
    muted text, monochrome: white is the only accent, red only for errors) with retro pixel accents (Press Start 2P for
    headings and labels, crisp 1px rules, no rounded blobs).
  -->

  <Styles.Resources>
    <ResourceDictionary>
      <Color x:Key="Px.Bg">#0A0A0A</Color>
      <Color x:Key="Px.Panel">#111111</Color>
      <Color x:Key="Px.PanelRaised">#181818</Color>
      <Color x:Key="Px.Border">#242424</Color>
      <Color x:Key="Px.BorderStrong">#303030</Color>
      <Color x:Key="Px.Text">#F2F2F2</Color>
      <Color x:Key="Px.TextMuted">#8C8C8C</Color>
      <Color x:Key="Px.TextDim">#5A5A5A</Color>
      <Color x:Key="Px.Accent">#FFFFFF</Color>
      <Color x:Key="Px.AccentSoft">#222222</Color>
      <Color x:Key="Px.Good">#FFFFFF</Color>
      <Color x:Key="Px.Warn">#A6A6A6</Color>
      <Color x:Key="Px.Bad">#FF5C5C</Color>

      <SolidColorBrush x:Key="Px.Brush.Bg" Color="{StaticResource Px.Bg}" />
      <SolidColorBrush x:Key="Px.Brush.Panel" Color="{StaticResource Px.Panel}" />
      <SolidColorBrush x:Key="Px.Brush.PanelRaised" Color="{StaticResource Px.PanelRaised}" />
      <SolidColorBrush x:Key="Px.Brush.Border" Color="{StaticResource Px.Border}" />
      <SolidColorBrush x:Key="Px.Brush.BorderStrong" Color="{StaticResource Px.BorderStrong}" />
      <SolidColorBrush x:Key="Px.Brush.Text" Color="{StaticResource Px.Text}" />
      <SolidColorBrush x:Key="Px.Brush.TextMuted" Color="{StaticResource Px.TextMuted}" />
      <SolidColorBrush x:Key="Px.Brush.TextDim" Color="{StaticResource Px.TextDim}" />
      <SolidColorBrush x:Key="Px.Brush.Accent" Color="{StaticResource Px.Accent}" />
      <SolidColorBrush x:Key="Px.Brush.AccentSoft" Color="{StaticResource Px.AccentSoft}" />
      <SolidColorBrush x:Key="Px.Brush.Good" Color="{StaticResource Px.Good}" />
      <SolidColorBrush x:Key="Px.Brush.Warn" Color="{StaticResource Px.Warn}" />
      <SolidColorBrush x:Key="Px.Brush.Bad" Color="{StaticResource Px.Bad}" />

      <!-- Kill the Fluent blue everywhere: check boxes, combo focus, selection. -->
      <Color x:Key="SystemAccentColor">#F2F2F2</Color>
      <Color x:Key="SystemAccentColorDark1">#D9D9D9</Color>
      <Color x:Key="SystemAccentColorDark2">#BFBFBF</Color>
      <Color x:Key="SystemAccentColorDark3">#A6A6A6</Color>
      <Color x:Key="SystemAccentColorLight1">#FFFFFF</Color>
      <Color x:Key="SystemAccentColorLight2">#FFFFFF</Color>
      <Color x:Key="SystemAccentColorLight3">#FFFFFF</Color>
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#0A0A0A" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#0A0A0A" />
      <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#0A0A0A" />

      <FontFamily x:Key="Px.Font.Pixel">avares://Pixelscreens/Assets/Fonts#Press Start 2P</FontFamily>
      <FontFamily x:Key="Px.Font.Body">fonts:Inter#Inter</FontFamily>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Px.Brush.Bg}" />
    <Setter Property="FontFamily" Value="{StaticResource Px.Font.Body}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
  </Style>

  <!-- Pixel-font labels: small, spaced, muted. Used for section headers and nav. -->
  <Style Selector="TextBlock.pixel">
    <Setter Property="FontFamily" Value="{StaticResource Px.Font.Pixel}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.pixel.title">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.TextDim}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Flat panels with a hairline border, no radius. -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource Px.Brush.Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16" />
  </Style>
  <Style Selector="Border.row">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Border}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style Selector="Border.row:pointerover">
    <Setter Property="Background" Value="{StaticResource Px.Brush.PanelRaised}" />
  </Style>

  <!-- Nav buttons: text-only, accent bar on the left when selected. -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="Transparent" Padding="14,10" BorderThickness="2,0,0,0" BorderBrush="Transparent">
          <TextBlock Classes="pixel" Text="{TemplateBinding Content}" VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav:pointerover /template/ Border#PART_Root">
    <Setter Property="Background" Value="{StaticResource Px.Brush.PanelRaised}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#PART_Root">
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Accent}" />
    <Setter Property="Background" Value="{StaticResource Px.Brush.PanelRaised}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
  </Style>

  <!-- Tiny unit toggle (in / mm) -->
  <Style Selector="RadioButton.unit">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Root" Background="Transparent" BorderBrush="{StaticResource Px.Brush.BorderStrong}" BorderThickness="1" Padding="8,2">
          <TextBlock Classes="pixel" FontSize="7" Text="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="RadioButton.unit:checked /template/ Border#PART_Root">
    <Setter Property="Background" Value="{StaticResource Px.Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Accent}" />
  </Style>
  <Style Selector="RadioButton.unit:checked /template/ TextBlock">
    <Setter Property="Foreground" Value="#0A0A0A" />
  </Style>

  <!-- Buttons: square, hairline, accent fill for primary. -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{StaticResource Px.Brush.PanelRaised}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Px.Brush.BorderStrong}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{StaticResource Px.Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Accent}" />
    <Setter Property="Foreground" Value="#0A0A0A" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#D9D9D9" />
  </Style>

  <!--
    Pixel buttons: pixel font, 2px frame with notched corners (each corner pixel knocked out), and a hard
    2px drop shadow that the button "presses" into. Same height everywhere so rows line up.
  -->
  <Style Selector="Button.px">
    <Setter Property="Background" Value="{StaticResource Px.Brush.PanelRaised}" />
    <Setter Property="BorderBrush" Value="#4A4A4A" />
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
    <Setter Property="Padding" Value="14,0" />
    <Setter Property="MinWidth" Value="88" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Margin="0,0,2,2">
          <Border Name="PART_Shadow" Background="#000000" Margin="2,2,-2,-2" />
          <Border Name="PART_Body" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="2" Padding="{TemplateBinding Padding}">
            <TextBlock Name="PART_Text" Text="{TemplateBinding Content}" FontFamily="{StaticResource Px.Font.Pixel}" FontSize="8"
                       LetterSpacing="1" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Rectangle Width="2" Height="2" Fill="{StaticResource Px.Brush.Panel}" HorizontalAlignment="Left" VerticalAlignment="Top" />
          <Rectangle Width="2" Height="2" Fill="{StaticResource Px.Brush.Panel}" HorizontalAlignment="Right" VerticalAlignment="Top" />
          <Rectangle Width="2" Height="2" Fill="{StaticResource Px.Brush.Panel}" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
          <Rectangle Width="2" Height="2" Fill="{StaticResource Px.Brush.Panel}" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.px:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Accent}" />
  </Style>
  <Style Selector="Button.px:pressed /template/ Panel">
    <Setter Property="RenderTransform" Value="translate(2px, 2px)" />
  </Style>
  <Style Selector="Button.px:pressed /template/ Border#PART_Shadow">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.px:disabled">
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.TextDim}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.BorderStrong}" />
    <Setter Property="Background" Value="{StaticResource Px.Brush.Panel}" />
    <Setter Property="Cursor" Value="Arrow" />
  </Style>
  <Style Selector="Button.px.primary">
    <Setter Property="Background" Value="{StaticResource Px.Brush.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Accent}" />
    <Setter Property="Foreground" Value="#0A0A0A" />
  </Style>
  <Style Selector="Button.px.primary:pointerover">
    <Setter Property="Background" Value="#D9D9D9" />
    <Setter Property="BorderBrush" Value="#D9D9D9" />
  </Style>
  <!-- A toggled-on state (e.g. startup profile): green frame and text, dark body. -->
  <Style Selector="Button.px.on">
    <Setter Property="BorderBrush" Value="#8FE0A6" />
    <Setter Property="Foreground" Value="#8FE0A6" />
  </Style>
  <Style Selector="Button.px.danger:pointerover">
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Bad}" />
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Bad}" />
  </Style>

  <!-- Disabled wins over every variant (declared last on purpose). -->
  <Style Selector="Button.px:disabled">
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.TextDim}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.BorderStrong}" />
    <Setter Property="Background" Value="{StaticResource Px.Brush.Panel}" />
  </Style>
  <Style Selector="TextBlock.good">
    <Setter Property="Foreground" Value="#8FE0A6" />
  </Style>
  <Style Selector="TextBlock.bad">
    <Setter Property="Foreground" Value="#FF8C8C" />
  </Style>

  <!-- Bare clickable wrapper (e.g. around a preview): no chrome, hand cursor, outline on hover. -->
  <Style Selector="Button.bare">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Ring" BorderBrush="Transparent" BorderThickness="1">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="Button.bare:pointerover /template/ Border#PART_Ring">
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.TextMuted}" />
  </Style>

  <!-- Status chip -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{StaticResource Px.Brush.AccentSoft}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.Accent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="TextBox, NumericUpDown">
    <Setter Property="Background" Value="{StaticResource Px.Brush.Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
    <Setter Property="MinHeight" Value="30" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{StaticResource Px.Brush.Bg}" />
    <Setter Property="BorderBrush" Value="{StaticResource Px.Brush.BorderStrong}" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Px.Brush.Text}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

</Styles>
