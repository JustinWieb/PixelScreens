<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pixelscreens.ViewModels"
        xmlns:px="using:Pixelscreens.Controls"
        x:Class="Pixelscreens.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PixelScreens"
        Icon="avares://Pixelscreens/Assets/pixelscreens.ico"
        Width="1040" Height="680"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="200,*">

    <!-- Title bar strip -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Px.Brush.Panel}"
            BorderBrush="{StaticResource Px.Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <px:PixelSprite Width="24" PixelSize="3" Speed="0" BodyBrush="{StaticResource Px.Brush.Accent}" EyeBrush="{StaticResource Px.Brush.Bg}" />
          <TextBlock Classes="pixel title" Text="PIXELSCREENS" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Classes="dim" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Text="display templates · cursor layout" />
      </DockPanel>
    </Border>

    <!-- Left nav -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Px.Brush.Panel}"
            BorderBrush="{StaticResource Px.Brush.Border}" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,12,0,0">
        <RadioButton Classes="nav" GroupName="nav" Content="PROFILES" IsChecked="{Binding SelectedTab, Converter={x:Static px:TabConverters.Is}, ConverterParameter=0}" />
        <RadioButton Classes="nav" GroupName="nav" Content="AUDIO"    IsChecked="{Binding SelectedTab, Converter={x:Static px:TabConverters.Is}, ConverterParameter=1}" />
        <RadioButton Classes="nav" GroupName="nav" Content="LAYOUT"   IsChecked="{Binding SelectedTab, Converter={x:Static px:TabConverters.Is}, ConverterParameter=2}" />
        <RadioButton Classes="nav" GroupName="nav" Content="SETTINGS" IsChecked="{Binding SelectedTab, Converter={x:Static px:TabConverters.Is}, ConverterParameter=3}" />
      </StackPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Row="1" Grid.Column="1" Margin="24">

      <!-- PROFILES -->
      <Panel IsVisible="{Binding ShowProfiles}">
      <DockPanel DataContext="{Binding Profiles}" x:DataType="vm:ProfilesViewModel">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="16,0,0,0">
            <TextBox Width="200" Watermark="new profile name" Text="{Binding NewProfileName}" IsEnabled="{Binding !Busy}" />
            <Button Classes="px primary" Content="SAVE CURRENT" Command="{Binding SaveCurrentCommand}" IsEnabled="{Binding !Busy}" />
            <Button Classes="px" Content="REFRESH" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="pixel" Text="DISPLAY PROFILES" />
            <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" Text="Saved monitor arrangements. Apply one to switch every screen at once." />
          </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Top" Classes="panel" Padding="0" Margin="0,0,0,12">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="12">
            <Button Classes="bare" Command="{Binding OpenLayoutCommand}" ToolTip.Tip="Edit this layout" VerticalAlignment="Center">
              <px:ProfilePreview Screens="{Binding CurrentScreens}" ShowLabels="True" Width="300" Height="150" />
            </Button>
            <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center" Spacing="4">
              <TextBlock Classes="pixel" FontSize="7" Text="ON SCREEN NOW" />
              <TextBlock Text="{Binding CurrentTitle}" FontSize="16" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="dim" Text="{Binding CurrentIdle}" IsVisible="{Binding HasCurrentIdle}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button Grid.Column="2" Classes="px primary" Content="EDIT LAYOUT" VerticalAlignment="Center" Command="{Binding OpenLayoutCommand}" />
          </Grid>
        </Border>
        <Border Classes="panel" Padding="0">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileRow">
                  <Border Classes="row">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Button Classes="bare" VerticalAlignment="Center" Command="{Binding EditCommand}" ToolTip.Tip="Edit">
                        <px:ProfilePreview Screens="{Binding Screens}" IsUsable="{Binding IsUsable}" Width="120" Height="68" />
                      </Button>
                      <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center" Spacing="4" ClipToBounds="True">
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="dim" Text="{Binding Note}" Classes.bad="{Binding NoteIsBad}" Classes.good="{Binding NoteIsGood}" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasNote}" ToolTip.Tip="{Binding NoteDetail}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="px primary" Content="APPLY" Width="88" Command="{Binding ApplyCommand}" />
                        <Button Classes="px" Content="EDIT" Width="88" Command="{Binding EditCommand}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
      </Panel>

      <!-- AUDIO -->
      <Panel IsVisible="{Binding ShowAudio}">
      <DockPanel DataContext="{Binding Audio}" x:DataType="vm:AudioViewModel">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="16,0,0,0">
            <TextBox Width="200" Watermark="new audio profile name" Text="{Binding NewProfileName}" IsEnabled="{Binding !Busy}" />
            <Button Classes="px primary" Content="SAVE CURRENT" Command="{Binding SaveCurrentCommand}" IsEnabled="{Binding !Busy}" />
            <Button Classes="px" Content="REFRESH" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="pixel" Text="AUDIO PROFILES" />
            <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" Text="Saved default speaker, microphone, and volumes. Switch them with one click, a hotkey, or from the tray." />
          </StackPanel>
        </DockPanel>
        <Border Classes="panel" Padding="0">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AudioRow">
                  <Border Classes="row">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Classes="chip" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                          <TextBlock Classes="pixel" FontSize="7" Text="{Binding Badge}" Foreground="{StaticResource Px.Brush.Accent}" />
                        </Border>
                        <px:HotkeyBox Gesture="{Binding Hotkey}" ToolTip.Tip="Click, then press a key combination. Backspace clears." />
                        <Button Classes="px primary" Content="SWITCH" Width="96" Command="{Binding ApplyCommand}" IsEnabled="{Binding !IsActive}" />
                        <Button Classes="px danger" Content="DELETE" Width="96" Command="{Binding DeleteCommand}" />
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Classes="dim" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
      </Panel>

      <!-- LAYOUT -->
      <Panel IsVisible="{Binding ShowLayout}">
      <DockPanel>
      <!-- The profile being edited: its settings live here, and work whether or not it is on screen. -->
      <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,16" Padding="12" DataContext="{Binding Profiles}" x:DataType="vm:ProfilesViewModel">
        <WrapPanel>
          <StackPanel VerticalAlignment="Bottom" Spacing="6" Margin="0,0,24,8">
            <TextBlock Classes="pixel" FontSize="7" Text="PROFILE" />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasEditing}">
              <TextBox Width="240" Text="{Binding EditName}" Watermark="profile name" />
              <Button Classes="px" Content="RENAME" Command="{Binding RenameCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !HasEditing}">
              <TextBox Width="240" Text="{Binding NewProfileName}" Watermark="name this layout" />
              <Button Classes="px primary" Content="SAVE AS PROFILE" Command="{Binding SaveCurrentCommand}" />
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,8" IsVisible="{Binding HasEditing}">
            <StackPanel Spacing="6">
              <TextBlock Classes="pixel" FontSize="7" Text="HOTKEY" />
              <px:HotkeyBox Gesture="{Binding Editing.Hotkey}" Width="120" ToolTip.Tip="Click, then press keys. Backspace clears." />
            </StackPanel>
            <Button Classes="px" Classes.on="{Binding Editing.IsStartup}" Content="STARTUP" Width="104" VerticalAlignment="Bottom"
                    Command="{Binding Editing.ToggleStartupCommand}" ToolTip.Tip="{Binding Editing.StartupTip}" />
            <Button Classes="px primary" Content="APPLY" Width="88" VerticalAlignment="Bottom" Command="{Binding ApplyEditingCommand}" IsEnabled="{Binding Editing.CanApply}" IsVisible="{Binding EditingOffline}" />
            <Button Classes="px danger" Content="DELETE" Width="88" VerticalAlignment="Bottom" Command="{Binding Editing.DeleteCommand}" />
          </StackPanel>
        </WrapPanel>
      </Border>
      <Panel>
      <!-- Not on screen: show its arrangement. The preview takes whatever height is left; the monitor list never gets cut off. -->
      <Border Classes="panel" DataContext="{Binding Profiles}" x:DataType="vm:ProfilesViewModel" IsVisible="{Binding EditingOffline}">
        <DockPanel>
          <Border DockPanel.Dock="Bottom" Classes="panel" Margin="0,12,0,0" IsVisible="{Binding HasSwaps}">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="px primary" Content="REBUILD" VerticalAlignment="Bottom" Margin="16,0,0,0"
                      Command="{Binding RebuildCommand}" IsEnabled="{Binding !Busy}"
                      ToolTip.Tip="Arrange these live monitors like this profile, then save it under the same name." />
              <StackPanel Spacing="8">
                <TextBlock Classes="pixel" FontSize="7" Text="REPLACE MONITORS" />
                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl ItemsSource="{Binding Swaps}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:SwapRow">
                        <Grid ColumnDefinitions="*,32,*" Margin="0,3">
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding From}" Classes.bad="{Binding IsMissing}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="dim" Text="{Binding Spot}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Classes="muted" Text="→" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </DockPanel>
          </Border>
          <TextBlock DockPanel.Dock="Bottom" Classes="dim" HorizontalAlignment="Center" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"
                     Text="{Binding Editing.Note}" Classes.bad="{Binding Editing.NoteIsBad}" />
          <px:ProfilePreview Screens="{Binding Editing.Screens}" ShowLabels="True" MinHeight="120" />
        </DockPanel>
      </Border>
      <DockPanel DataContext="{Binding Layout}" x:DataType="vm:LayoutViewModel"
                 IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).Profiles.EditingLive}">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <WrapPanel.Styles><Style Selector="Button"><Setter Property="Margin" Value="0,0,8,0" /></Style></WrapPanel.Styles>
            <Button Classes="px" Content="SHOW ALL" Command="{Binding ShowAllCommand}" IsVisible="{Binding IsFocused}" />
            <Button Classes="px" Content="MATCH WINDOWS" Command="{Binding MatchWindowsCommand}" IsEnabled="{Binding !Busy}"
                    ToolTip.Tip="Rebuild the physical layout from the Windows arrangement: same neighbours, real sizes. Fine-tune by dragging afterwards." />
            <Button Classes="px" Content="RESCAN" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" />
            <Button Classes="px" Content="SAVE" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" ToolTip.Tip="Edits save on their own a moment after you stop. This forces it immediately." />
            <Button Classes="px primary" Content="ENABLE" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}" IsEnabled="{Binding !Busy}" />
            <Button Classes="px on" Content="ENABLED" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" IsEnabled="{Binding !Busy}" ToolTip.Tip="Cursor engine is on. Click to turn it off." />
          </WrapPanel>
          <StackPanel>
            <TextBlock Classes="pixel" Text="PHYSICAL LAYOUT" />
            <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" Text="Drag screens to where they sit on your desk. The mouse crosses at the matching physical spot." />
          </StackPanel>
        </DockPanel>
        <Grid ColumnDefinitions="*,16,260">
          <Border Classes="panel" Padding="0" ClipToBounds="True">
            <px:LayoutCanvas x:Name="LayoutCanvas" Monitors="{Binding Monitors}" Focused="{Binding Focused}"
                             PixelFont="{StaticResource Px.Font.Pixel}"
                             BoxBrush="{StaticResource Px.Brush.PanelRaised}"
                             BorderBrush="{StaticResource Px.Brush.BorderStrong}"
                             AccentBrush="{StaticResource Px.Brush.Accent}"
                             TextBrush="{StaticResource Px.Brush.Text}"
                             MutedBrush="{StaticResource Px.Brush.TextMuted}" />
          </Border>
          <Border Grid.Column="2" Classes="panel" Padding="0">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Margin="16">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                  <RadioButton Classes="unit" GroupName="units" Content="in" IsChecked="{Binding UseInches}" />
                  <RadioButton Classes="unit" GroupName="units" Content="mm" IsChecked="{Binding !UseInches}" />
                </StackPanel>
                <TextBlock Classes="pixel" Text="MONITOR" VerticalAlignment="Center" />
              </DockPanel>
              <TextBlock Classes="muted" Text="Click a screen to edit it. Double-click to open it alone. Drag corners to resize, drag edges to set bezels." IsVisible="{Binding !HasSelection}" TextWrapping="Wrap" />
              <Panel IsVisible="{Binding HasSelection}">
              <StackPanel Spacing="12" DataContext="{Binding Selected}" x:DataType="vm:MonitorBox">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Classes="dim" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="pixel" FontSize="7" Text="SIZE" />
                  <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,4,Auto,8,Auto,4,Auto">
                    <TextBlock Classes="dim" Text="diagonal (in)" />
                    <NumericUpDown Grid.Row="2" Value="{Binding DiagonalInches}" Increment="0.5" Minimum="5" Maximum="120" FormatString="0.0" ShowButtonSpinner="False" />
                    <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Unit, StringFormat='width ({0})'}" />
                    <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding WidthU}" Increment="0.1" Minimum="1" Maximum="3000" FormatString="0.##" ShowButtonSpinner="False" />
                    <TextBlock Grid.Row="4" Classes="dim" Text="{Binding Unit, StringFormat='height ({0})'}" />
                    <NumericUpDown Grid.Row="6" Value="{Binding HeightU}" Increment="0.1" Minimum="1" Maximum="3000" FormatString="0.##" ShowButtonSpinner="False" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="pixel" FontSize="7" Text="{Binding Unit, StringFormat='BEZEL ({0})'}" />
                  <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,4,Auto,8,Auto,4,Auto">
                    <TextBlock Classes="dim" Text="top" />
                    <NumericUpDown Grid.Row="2" Value="{Binding BezelTopU}" Increment="0.05" Minimum="0" Maximum="200" FormatString="0.##" ShowButtonSpinner="False" />
                    <TextBlock Grid.Column="2" Classes="dim" Text="right" />
                    <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding BezelRightU}" Increment="0.05" Minimum="0" Maximum="200" FormatString="0.##" ShowButtonSpinner="False" />
                    <TextBlock Grid.Row="4" Classes="dim" Text="bottom" />
                    <NumericUpDown Grid.Row="6" Value="{Binding BezelBottomU}" Increment="0.05" Minimum="0" Maximum="200" FormatString="0.##" ShowButtonSpinner="False" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Classes="dim" Text="left" />
                    <NumericUpDown Grid.Row="6" Grid.Column="2" Value="{Binding BezelLeftU}" Increment="0.05" Minimum="0" Maximum="200" FormatString="0.##" ShowButtonSpinner="False" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                  <TextBlock Classes="pixel" FontSize="7" Text="OVERALL" />
                  <TextBlock Classes="muted" Text="{Binding OutsideText}" />
                </StackPanel>
              </StackPanel>
              </Panel>
              <StackPanel Spacing="6" IsVisible="{Binding HasScale}">
                <TextBlock Classes="pixel" FontSize="7" Text="SCALE" />
                <ComboBox ItemsSource="{Binding ScaleOptions}" SelectedItem="{Binding SelectedScale}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </DockPanel>
      </Panel>
      </DockPanel>
      </Panel>

      <!-- SETTINGS -->
      <Panel IsVisible="{Binding ShowSettings}">
      <ScrollViewer DataContext="{Binding Options}" x:DataType="vm:SettingsViewModel">
      <StackPanel Spacing="16" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Classes="pixel" Text="SETTINGS" />
          <TextBlock Classes="muted" Margin="0,6,0,0" Text="Startup, hotkeys, cursor engine, and Windows skin." />
        </StackPanel>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="pixel" Text="STARTUP" />
            <CheckBox Content="Start with Windows (signed in, no prompt)" IsChecked="{Binding StartWithWindows}" />
            <CheckBox Content="When started with Windows, stay in the tray (opening it yourself always shows the window)" IsChecked="{Binding StartMinimized}" />
            <CheckBox Content="Close button hides to the tray (Exit is in the tray menu)" IsChecked="{Binding CloseToTray}" />
            <CheckBox Content="Enable the cursor engine when PixelScreens starts" IsChecked="{Binding EnableCursorOnStart}" />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="pixel" Text="HOTKEYS" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="System-wide. Per-profile hotkeys live on each row in Profiles and Audio. Click a box, press keys, Backspace clears." />
            <Grid ColumnDefinitions="220,Auto" RowDefinitions="Auto,8,Auto">
              <TextBlock Text="Show PixelScreens" VerticalAlignment="Center" />
              <px:HotkeyBox Grid.Column="1" Gesture="{Binding ShowHotkey}" />
              <TextBlock Grid.Row="2" Text="Toggle cursor engine" VerticalAlignment="Center" />
              <px:HotkeyBox Grid.Row="2" Grid.Column="1" Gesture="{Binding ToggleCursorHotkey}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="primary" Content="Apply" Command="{Binding ApplyCursorCommand}" IsEnabled="{Binding CursorDirty}" />
              <TextBlock Classes="pixel" Text="CURSOR ENGINE" VerticalAlignment="Center" />
            </DockPanel>
            <Grid ColumnDefinitions="220,240" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
              <TextBlock Text="Crossing algorithm" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Text="Max travel distance (mm)" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxTravelDistance}" Minimum="0" Maximum="5000" Increment="10" FormatString="0" ShowButtonSpinner="False" />
              <TextBlock Grid.Row="4" Text="Rescue shortcut" VerticalAlignment="Center" ToolTip.Tip="Hold this to free a trapped cursor" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RescueShortcut}" />
            </Grid>
            <TextBlock Classes="muted" Text="Cross follows the shortest straight line between screens. Strait keeps the cursor at the same height." TextWrapping="Wrap" />
            <WrapPanel>
              <CheckBox Content="Loop left to right" IsChecked="{Binding LoopX}" Margin="0,0,16,0" />
              <CheckBox Content="Loop top to bottom" IsChecked="{Binding LoopY}" Margin="0,0,16,0" />
              <CheckBox Content="Scale pointer size per screen" IsChecked="{Binding AdjustPointer}" Margin="0,0,16,0" />
              <CheckBox Content="Scale pointer speed per screen" IsChecked="{Binding AdjustSpeed}" Margin="0,0,16,0" />
              <CheckBox Content="Allow gaps between screens" IsChecked="{Binding AllowDiscontinuity}" Margin="0,0,16,0" />
              <CheckBox Content="Allow overlapping screens" IsChecked="{Binding AllowOverlaps}" Margin="0,0,16,0" />
              <CheckBox Content="Pause when a game captures the mouse" IsChecked="{Binding FreelookEnabled}" Margin="0,0,16,0" />
            </WrapPanel>
            <TextBlock Classes="dim" Text="Pause in these apps (one per line, part of the exe path is enough, e.g. \\steam\\)" />
            <TextBox Text="{Binding ExcludedApps}" AcceptsReturn="True" Height="90" TextWrapping="NoWrap" FontFamily="Consolas" />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Content="Clean taskbar" Command="{Binding CleanTaskbarCommand}" ToolTip.Tip="Turn off search highlights, Widgets, Task View, Chat, Copilot; search as icon only" />
                <Button Content="Restart Explorer" Command="{Binding RestartExplorerCommand}" />
              </StackPanel>
              <TextBlock Classes="pixel" Text="TASKBAR" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="These change Windows directly, the moment you click. Most apply live; if one doesn't, restart Explorer." />
            <Grid ColumnDefinitions="220,240" RowDefinitions="Auto">
              <TextBlock Text="Search box" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SearchBoxModes}" SelectedIndex="{Binding SearchBoxMode}" HorizontalAlignment="Stretch" />
            </Grid>
            <WrapPanel>
              <CheckBox Content="Search highlights (the emoji in the search box)" IsChecked="{Binding SearchHighlights}" Margin="0,0,16,0" />
              <CheckBox Content="Widgets button" IsChecked="{Binding Widgets}" Margin="0,0,16,0" />
              <CheckBox Content="Task View button" IsChecked="{Binding TaskView}" Margin="0,0,16,0" />
              <CheckBox Content="Chat button" IsChecked="{Binding Chat}" Margin="0,0,16,0" />
              <CheckBox Content="Copilot button" IsChecked="{Binding Copilot}" Margin="0,0,16,0" />
              <CheckBox Content="Centre the taskbar (off = left, Windows 10 style)" IsChecked="{Binding CenterTaskbar}" Margin="0,0,16,0" />
              <CheckBox Content="Accent colour on Start and taskbar" IsChecked="{Binding AccentOnTaskbar}" Margin="0,0,16,0" />
            </WrapPanel>
            <TextBlock Classes="dim" TextWrapping="Wrap" Text="For a custom Start button image or a solid taskbar colour, install Windhawk (Start button styler) or TranslucentTB. Windows has no setting for those." />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="pixel" Text="WINDOWS COLOURS" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="Pick the Windows accent colour. It shows on Start, taskbar highlights, toggles, and selected items. Title bars stay plain unless you turn that on." />
            <ItemsControl ItemsSource="{Binding Palette}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Button Width="34" Height="34" Margin="0,0,6,6" Padding="0" BorderThickness="1"
                          Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).PickAccentCommand}" CommandParameter="{Binding}"
                          ToolTip.Tip="{Binding}">
                    <Border Background="{Binding, Converter={x:Static px:TabConverters.HexToBrush}}" Width="26" Height="26" />
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Expander Header="Colour wheel" Padding="0" IsExpanded="True">
              <StackPanel Spacing="8" Margin="0,8,0,0">
                <ColorView x:Name="AccentWheel" Color="{Binding WheelColor, Mode=TwoWay}" IsAlphaEnabled="False" IsColorPaletteVisible="False" IsComponentSliderVisible="True" IsHexInputVisible="True" Width="380" HorizontalAlignment="Left" />
                <Button Content="Apply this colour" Command="{Binding ApplyWheelCommand}" />
              </StackPanel>
            </Expander>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Custom" VerticalAlignment="Center" />
              <TextBox Width="120" Watermark="#7C7CFF" Text="{Binding CustomHex}" />
              <Button Content="Apply" Command="{Binding ApplyCustomHexCommand}" />
              <Border Width="26" Height="26" Background="{Binding AccentHex, Converter={x:Static px:TabConverters.HexToBrush}}" BorderBrush="{StaticResource Px.Brush.BorderStrong}" BorderThickness="1" VerticalAlignment="Center" />
              <TextBlock Classes="dim" Text="{Binding WindowsThemeState}" VerticalAlignment="Center" />
            </StackPanel>
            <WrapPanel>
              <CheckBox Content="Dark mode" IsChecked="{Binding DarkMode}" Margin="0,0,16,0" />
              <CheckBox Content="Accent on title bars and window borders" IsChecked="{Binding AccentOnTitleBars}" Margin="0,0,16,0" />
              <CheckBox Content="Transparency effects" IsChecked="{Binding Transparency}" Margin="0,0,16,0" />
              <CheckBox Content="Web results in Start search (off is faster)" IsChecked="{Binding WebSearch}" Margin="0,0,16,0" />
            </WrapPanel>
            <TextBlock Classes="dim" TextWrapping="Wrap" Text="Want Everything as your taskbar search? Install EverythingToolbar from GitHub; it replaces the search box with instant results." />
          </StackPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
      </Panel>

    </Grid>

    <!-- Footer: status + wandering sprite -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Px.Brush.Panel}"
            BorderBrush="{StaticResource Px.Brush.Border}" BorderThickness="0,1,0,0" Padding="16,6">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{StaticResource Px.Brush.Good}" IsVisible="{Binding FooterOk}" />
          <Ellipse Width="6" Height="6" Fill="{StaticResource Px.Brush.Bad}" IsVisible="{Binding !FooterOk}" />
          <TextBlock Classes="dim" Text="{Binding FooterStatus}" VerticalAlignment="Center" />
        </StackPanel>
        <px:PixelSprite Grid.Column="1" Margin="24,0,0,0" PixelSize="2" Speed="30"
                        BodyBrush="{StaticResource Px.Brush.TextDim}" EyeBrush="{StaticResource Px.Brush.Bg}" />
      </Grid>
    </Border>

  </Grid>
</Window>
