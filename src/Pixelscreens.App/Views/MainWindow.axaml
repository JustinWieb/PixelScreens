<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Pixelscreens.ViewModels"
        xmlns:px="using:Pixelscreens.Controls"
        x:Class="Pixelscreens.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="PixelScreens"
        Icon="avares://Pixelscreens/Assets/pixelscreens.ico"
        Width="1040" Height="680"
        MinWidth="760" MinHeight="500"
        WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="200,*">

    <!-- Title bar strip -->
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource Px.Brush.Panel}"
            BorderBrush="{StaticResource Px.Brush.Border}" BorderThickness="0,0,0,1" Padding="16,12">
      <DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <px:PixelSprite Width="24" PixelSize="3" Speed="0" BodyBrush="{StaticResource Px.Brush.Accent}" EyeBrush="{StaticResource Px.Brush.Bg}" />
          <TextBlock Classes="pixel title" Text="PIXELSCREENS" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Classes="dim" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Text="display templates · cursor layout" />
      </DockPanel>
    </Border>

    <!-- Left nav -->
    <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Px.Brush.Panel}"
            BorderBrush="{StaticResource Px.Brush.Border}" BorderThickness="0,0,1,0">
      <StackPanel Margin="0,12,0,0">
        <RadioButton Classes="nav" GroupName="nav" Content="PROFILES" IsChecked="{Binding SelectedTab, Converter={x:Static px:TabConverters.Is}, ConverterParameter=0}" />
        <RadioButton Classes="nav" GroupName="nav" Content="AUDIO"    IsChecked="{Binding SelectedTab, Converter={x:Static px:TabConverters.Is}, ConverterParameter=1}" />
        <RadioButton Classes="nav" GroupName="nav" Content="LAYOUT"   IsChecked="{Binding SelectedTab, Converter={x:Static px:TabConverters.Is}, ConverterParameter=2}" />
        <RadioButton Classes="nav" GroupName="nav" Content="SETTINGS" IsChecked="{Binding SelectedTab, Converter={x:Static px:TabConverters.Is}, ConverterParameter=3}" />
      </StackPanel>
    </Border>

    <!-- Content -->
    <Grid Grid.Row="1" Grid.Column="1" Margin="24">

      <!-- PROFILES -->
      <Panel IsVisible="{Binding ShowProfiles}">
      <DockPanel DataContext="{Binding Profiles}" x:DataType="vm:ProfilesViewModel">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="16,0,0,0">
            <TextBox Width="200" Watermark="new profile name" Text="{Binding NewProfileName}" IsEnabled="{Binding !Busy}" />
            <Button Classes="primary" Content="Save current" Command="{Binding SaveCurrentCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="pixel" Text="DISPLAY PROFILES" />
            <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" Text="Saved monitor arrangements. Apply one to switch every screen at once." />
          </StackPanel>
        </DockPanel>
        <Border Classes="panel" Padding="0">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProfileRow">
                  <Border Classes="row">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Classes="chip" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                          <TextBlock Classes="pixel" FontSize="7" Text="{Binding Badge}" Foreground="{StaticResource Px.Brush.Accent}" />
                        </Border>
                        <px:HotkeyBox Gesture="{Binding Hotkey}" ToolTip.Tip="Click, then press a key combination. Backspace clears." />
                        <Button Content="Apply" Command="{Binding ApplyCommand}" IsVisible="{Binding CanApply}" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" />
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Classes="dim" Text="{Binding Uuid}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
      </Panel>

      <!-- AUDIO -->
      <Panel IsVisible="{Binding ShowAudio}">
      <DockPanel DataContext="{Binding Audio}" x:DataType="vm:AudioViewModel">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="16,0,0,0">
            <TextBox Width="200" Watermark="new audio profile name" Text="{Binding NewProfileName}" IsEnabled="{Binding !Busy}" />
            <Button Classes="primary" Content="Save current" Command="{Binding SaveCurrentCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="pixel" Text="AUDIO PROFILES" />
            <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" Text="Saved default speaker, microphone, and volumes. Switch them with one click, a hotkey, or from the tray." />
          </StackPanel>
        </DockPanel>
        <Border Classes="panel" Padding="0">
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Profiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:AudioRow">
                  <Border Classes="row">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Classes="chip" IsVisible="{Binding HasBadge}" VerticalAlignment="Center">
                          <TextBlock Classes="pixel" FontSize="7" Text="{Binding Badge}" Foreground="{StaticResource Px.Brush.Accent}" />
                        </Border>
                        <px:HotkeyBox Gesture="{Binding Hotkey}" ToolTip.Tip="Click, then press a key combination. Backspace clears." />
                        <Button Content="Switch" Command="{Binding ApplyCommand}" IsVisible="{Binding !IsActive}" />
                        <Button Content="Delete" Command="{Binding DeleteCommand}" />
                      </StackPanel>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Classes="dim" Text="{Binding Detail}" TextWrapping="Wrap" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Border>
      </DockPanel>
      </Panel>

      <!-- LAYOUT -->
      <Panel IsVisible="{Binding ShowLayout}">
      <DockPanel DataContext="{Binding Layout}" x:DataType="vm:LayoutViewModel">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top" Margin="16,0,0,0">
            <Button Content="Rescan" Command="{Binding RefreshCommand}" IsEnabled="{Binding !Busy}" />
            <Button Content="Apply layout" Command="{Binding SaveCommand}" IsEnabled="{Binding Dirty}" />
            <Button Classes="primary" Content="Enable" Command="{Binding StartCommand}" IsVisible="{Binding !IsRunning}" IsEnabled="{Binding !Busy}" />
            <Button Content="Disable" Command="{Binding StopCommand}" IsVisible="{Binding IsRunning}" IsEnabled="{Binding !Busy}" />
          </StackPanel>
          <StackPanel>
            <TextBlock Classes="pixel" Text="PHYSICAL LAYOUT" />
            <TextBlock Classes="muted" Margin="0,6,0,0" TextWrapping="Wrap" Text="Drag screens to where they really sit on your desk. When enabled, the mouse crosses between screens at the matching physical spot instead of jumping. Windows still decides which screen is where." />
          </StackPanel>
        </DockPanel>
        <Grid ColumnDefinitions="*,16,260">
          <Border Classes="panel" Padding="0" ClipToBounds="True">
            <px:LayoutCanvas x:Name="LayoutCanvas" Monitors="{Binding Monitors}"
                             PixelFont="{StaticResource Px.Font.Pixel}"
                             BoxBrush="{StaticResource Px.Brush.PanelRaised}"
                             BorderBrush="{StaticResource Px.Brush.BorderStrong}"
                             AccentBrush="{StaticResource Px.Brush.Accent}"
                             TextBrush="{StaticResource Px.Brush.Text}"
                             MutedBrush="{StaticResource Px.Brush.TextMuted}" />
          </Border>
          <Border Grid.Column="2" Classes="panel">
            <StackPanel Spacing="12">
              <TextBlock Classes="pixel" Text="MONITOR" />
              <TextBlock Classes="muted" Text="Click a screen on the left to edit it." IsVisible="{Binding !HasSelection}" TextWrapping="Wrap" />
              <Panel IsVisible="{Binding HasSelection}">
              <StackPanel Spacing="12" DataContext="{Binding Selected}" x:DataType="vm:MonitorBox">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" />
                  <TextBlock Classes="dim" Text="{Binding Detail}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="pixel" FontSize="7" Text="SIZE" />
                  <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,4,Auto,8,Auto,4,Auto">
                    <TextBlock Classes="dim" Text="diagonal (in)" />
                    <NumericUpDown Grid.Row="2" Value="{Binding DiagonalInches}" Increment="0.5" Minimum="5" Maximum="120" FormatString="0.0" ShowButtonSpinner="False" />
                    <TextBlock Grid.Column="2" Classes="dim" Text="width (mm)" />
                    <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding WidthMm}" Increment="1" Minimum="50" Maximum="3000" FormatString="0" ShowButtonSpinner="False" />
                    <TextBlock Grid.Row="4" Classes="dim" Text="height (mm)" />
                    <NumericUpDown Grid.Row="6" Value="{Binding HeightMm}" Increment="1" Minimum="30" Maximum="3000" FormatString="0" ShowButtonSpinner="False" />
                  </Grid>
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="pixel" FontSize="7" Text="BEZEL (MM)" />
                  <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,4,Auto,8,Auto,4,Auto">
                    <TextBlock Classes="dim" Text="top" />
                    <NumericUpDown Grid.Row="2" Value="{Binding BezelTopMm}" Increment="0.5" Minimum="0" Maximum="200" FormatString="0.0" ShowButtonSpinner="False" />
                    <TextBlock Grid.Column="2" Classes="dim" Text="right" />
                    <NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding BezelRightMm}" Increment="0.5" Minimum="0" Maximum="200" FormatString="0.0" ShowButtonSpinner="False" />
                    <TextBlock Grid.Row="4" Classes="dim" Text="bottom" />
                    <NumericUpDown Grid.Row="6" Value="{Binding BezelBottomMm}" Increment="0.5" Minimum="0" Maximum="200" FormatString="0.0" ShowButtonSpinner="False" />
                    <TextBlock Grid.Row="4" Grid.Column="2" Classes="dim" Text="left" />
                    <NumericUpDown Grid.Row="6" Grid.Column="2" Value="{Binding BezelLeftMm}" Increment="0.5" Minimum="0" Maximum="200" FormatString="0.0" ShowButtonSpinner="False" />
                  </Grid>
                </StackPanel>
                <TextBlock Classes="dim" TextWrapping="Wrap" Text="Changes preview on the canvas. Press Apply layout to save them and update the cursor engine." />
              </StackPanel>
              </Panel>
            </StackPanel>
          </Border>
        </Grid>
      </DockPanel>
      </Panel>

      <!-- SETTINGS -->
      <Panel IsVisible="{Binding ShowSettings}">
      <ScrollViewer DataContext="{Binding Options}" x:DataType="vm:SettingsViewModel">
      <StackPanel Spacing="16" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Classes="pixel" Text="SETTINGS" />
          <TextBlock Classes="muted" Margin="0,6,0,0" Text="Startup, hotkeys, cursor engine, and Windows skin." />
        </StackPanel>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="pixel" Text="STARTUP" />
            <CheckBox Content="Start with Windows (signed in, no prompt)" IsChecked="{Binding StartWithWindows}" />
            <CheckBox Content="Start minimised to the tray" IsChecked="{Binding StartMinimized}" />
            <CheckBox Content="Close button hides to the tray (Exit is in the tray menu)" IsChecked="{Binding CloseToTray}" />
            <CheckBox Content="Enable the cursor engine when PixelScreens starts" IsChecked="{Binding EnableCursorOnStart}" />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <TextBlock Classes="pixel" Text="HOTKEYS" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="System-wide. Per-profile hotkeys live on each row in Profiles and Audio. Click a box, press keys, Backspace clears." />
            <Grid ColumnDefinitions="220,Auto" RowDefinitions="Auto,8,Auto">
              <TextBlock Text="Show PixelScreens" VerticalAlignment="Center" />
              <px:HotkeyBox Grid.Column="1" Gesture="{Binding ShowHotkey}" />
              <TextBlock Grid.Row="2" Text="Toggle cursor engine" VerticalAlignment="Center" />
              <px:HotkeyBox Grid.Row="2" Grid.Column="1" Gesture="{Binding ToggleCursorHotkey}" />
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <StackPanel Spacing="10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="primary" Content="Apply" Command="{Binding ApplyCursorCommand}" IsEnabled="{Binding CursorDirty}" />
              <TextBlock Classes="pixel" Text="CURSOR ENGINE" VerticalAlignment="Center" />
            </DockPanel>
            <Grid ColumnDefinitions="220,240" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
              <TextBlock Text="Crossing algorithm" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Algorithms}" SelectedItem="{Binding Algorithm}" HorizontalAlignment="Stretch" />
              <TextBlock Grid.Row="2" Text="Max travel distance (mm)" VerticalAlignment="Center" />
              <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxTravelDistance}" Minimum="0" Maximum="5000" Increment="10" FormatString="0" ShowButtonSpinner="False" />
              <TextBlock Grid.Row="4" Text="Rescue shortcut" VerticalAlignment="Center" ToolTip.Tip="Hold this to free a trapped cursor" />
              <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RescueShortcut}" />
            </Grid>
            <TextBlock Classes="muted" Text="Cross follows the shortest straight line between screens. Strait keeps the cursor at the same height." TextWrapping="Wrap" />
            <WrapPanel>
              <CheckBox Content="Loop left to right" IsChecked="{Binding LoopX}" Margin="0,0,16,0" />
              <CheckBox Content="Loop top to bottom" IsChecked="{Binding LoopY}" Margin="0,0,16,0" />
              <CheckBox Content="Scale pointer size per screen" IsChecked="{Binding AdjustPointer}" Margin="0,0,16,0" />
              <CheckBox Content="Scale pointer speed per screen" IsChecked="{Binding AdjustSpeed}" Margin="0,0,16,0" />
              <CheckBox Content="Allow gaps between screens" IsChecked="{Binding AllowDiscontinuity}" Margin="0,0,16,0" />
              <CheckBox Content="Allow overlapping screens" IsChecked="{Binding AllowOverlaps}" Margin="0,0,16,0" />
              <CheckBox Content="Pause when a game captures the mouse" IsChecked="{Binding FreelookEnabled}" Margin="0,0,16,0" />
            </WrapPanel>
            <TextBlock Classes="dim" Text="Pause in these apps (one per line, part of the exe path is enough, e.g. \\steam\\)" />
            <TextBox Text="{Binding ExcludedApps}" AcceptsReturn="True" Height="90" TextWrapping="NoWrap" FontFamily="Consolas" />
          </StackPanel>
        </Border>

        <Border Classes="panel">
          <DockPanel>
            <Button DockPanel.Dock="Right" Classes="primary" Content="Match Windows to this theme" Command="{Binding MatchWindowsCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
            <StackPanel Spacing="4">
              <TextBlock Classes="pixel" Text="WINDOWS SKIN" />
              <TextBlock Classes="muted" TextWrapping="Wrap" Text="Sets Windows to dark mode with a white accent on title bars, turns off transparency, and keeps the taskbar black." />
              <TextBlock Classes="dim" Text="{Binding WindowsThemeState}" />
            </StackPanel>
          </DockPanel>
        </Border>
      </StackPanel>
      </ScrollViewer>
      </Panel>

    </Grid>

    <!-- Footer: status + wandering sprite -->
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{StaticResource Px.Brush.Panel}"
            BorderBrush="{StaticResource Px.Brush.Border}" BorderThickness="0,1,0,0" Padding="16,6">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{StaticResource Px.Brush.Good}" IsVisible="{Binding FooterOk}" />
          <Ellipse Width="6" Height="6" Fill="{StaticResource Px.Brush.Bad}" IsVisible="{Binding !FooterOk}" />
          <TextBlock Classes="dim" Text="{Binding FooterStatus}" VerticalAlignment="Center" />
        </StackPanel>
        <px:PixelSprite Grid.Column="1" Margin="24,0,0,0" PixelSize="2" Speed="30"
                        BodyBrush="{StaticResource Px.Brush.TextDim}" EyeBrush="{StaticResource Px.Brush.Bg}" />
      </Grid>
    </Border>

  </Grid>
</Window>
